# CI/CD optimized Dockerfile
# build-job에서 이미 빌드된 dist/ 디렉토리를 직접 복사하여 빌드 시간 단축
#
# 사용법: docker build -f docker/Dockerfile.ci .
# 요구사항: dist/ 디렉토리가 이미 존재해야 함 (build-job artifacts)

FROM nginx:alpine

# 이미지 메타데이터 (dangling 이미지 식별용)
LABEL project="release-manager-web"
LABEL maintainer="ts-team"
LABEL version="1.0"

# CI에서 이미 빌드된 dist 디렉토리 복사 (node 빌드 스킵)
COPY dist/ /usr/share/nginx/html/

# Copy nginx configuration template
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template

# Environment variable for API server URL (set via docker-compose or docker run)
ENV API_SERVER_URL=http://localhost:8081

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

# Expose port 80
EXPOSE 80

# Start nginx with envsubst
CMD ["/bin/sh", "-c", "envsubst '$$API_SERVER_URL' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
