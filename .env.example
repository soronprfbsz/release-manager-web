# Development Server Configuration
SERVER_NAME=release-manager-web
SERVER_HOST=localhost
SERVER_PORT=3000

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8081

# Application Configuration
VITE_APP_TITLE=Release Manager

# API Timeout Configuration (milliseconds)
# Default timeout for general API calls (default: 30000 = 30 seconds)
VITE_API_TIMEOUT_DEFAULT=30000
# Timeout for file upload/download operations (default: 1800000 = 30 minutes)
VITE_API_TIMEOUT_FILE_OPERATION=1800000
