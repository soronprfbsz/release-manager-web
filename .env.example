# Development Server Configuration
SERVER_NAME=release-manager-web
SERVER_HOST=localhost
SERVER_PORT=3000

# Backend API Server URL
VITE_API_SERVER_URL=http://localhost:8081

# Application Configuration
VITE_APP_TITLE=Release Manager

# API Timeout Configuration (milliseconds)
# Default timeout for general API calls (default: 30000 = 30 seconds)
VITE_API_TIMEOUT_DEFAULT=30000
# Timeout for file upload/download operations (default: 7200000 = 2 hours)
VITE_API_TIMEOUT_FILE_OPERATION=7200000
